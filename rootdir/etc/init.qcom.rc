import /vendor/etc/init/hw/init.device.rc
import /vendor/etc/init/hw/init.qcom.usb.rc
import /vendor/etc/init/hw/init.msm.usb.configfs.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug
    chown root system /dev/kmsg
    chmod 0620 /dev/kmsg
    mkdir /mnt/fwmt 0771 system system
    mkdir /system 0777 root root
    symlink /data/tombstones /tombstones
    mount cgroup none /dev/memcg memory

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    mount_all /vendor/etc/fstab.qcom
    write /proc/sys/vm/swappiness 100

    chown root system /sys/class/power_supply/bms/current_now
    chown root system /sys/class/power_supply/bms/voltage_ocv
    chmod 0664 /sys/class/power_supply/bms/current_now
    chmod 0664 /sys/class/power_supply/bms/voltage_ocv
    chown root system /sys/power/wake_lock
    chown root system /sys/power/wake_unlock
    chmod 0660 /sys/power/wake_lock
    chmod 0660 /sys/power/wake_unlock

    mkdir /mnt/per/data 0700 system system
    restorecon_recursive /mnt/per

on fs && property:ro.vendor.vm_bms.enabled=1
    start vendor.vm_bms

on init
    mkdir /mnt/per 0771 root system

    mkdir /sys/fs/cgroup/memory/bg 0750 root system
    write /sys/fs/cgroup/memory/bg/memory.swappiness 140
    write /sys/fs/cgroup/memory/bg/memory.move_charge_at_immigrate 1
    chown root system /sys/fs/cgroup/memory/bg/tasks
    chmod 0660 /sys/fs/cgroup/memory/bg/tasks

    write /sys/module/qpnp_rtc/parameters/poweron_alarm 1

on post-fs
    chmod 0755 /sys/kernel/debug/tracing

on early-boot
    setrlimit 8 67108864 67108864
    write /sys/kernel/boot_adsp/boot 1
    chown root audio /sys/kernel/boot_adsp/boot

on boot && property:ro.baseband=msm
    start vendor.qmuxd

on boot

    chown system graphics /sys/class/graphics/fb0/idle_time
    chmod 0664 /sys/class/graphics/fb0/idle_time
    chown system graphics /sys/class/graphics/fb0/dynamic_fps
    chmod 0664 /sys/class/graphics/fb0/dynamic_fps
    chown system graphics /sys/class/graphics/fb0/dyn_pu
    chmod 0664 /sys/class/graphics/fb0/dyn_pu

    write /sys/class/kgsl/kgsl-3d0/default_pwrlevel 0
    write /proc/sys/vm/page-cluster 0

    chown system graphics /sys/class/graphics/fb0/modes
    chmod 0664 /sys/class/graphics/fb0/modes
    chown system graphics /sys/class/graphics/fb0/mode
    chmod 0664 /sys/class/graphics/fb0/mode
    chown system graphics /sys/class/graphics/fb0/msm_cmd_autorefresh_en
    chmod 0664 /sys/class/graphics/fb0/msm_cmd_autorefresh_en

    chown system system /sys/devices/system/cpu/cpu0/core_ctl/min_cpus
    chmod 0660 /sys/devices/system/cpu/cpu0/core_ctl/min_cpus

    chown system system /dev/stune/top-app/schedtune.boost
    chmod 0660 /dev/stune/top-app/schedtune.boost

    chown system system /sys/module/msm_core/parameters/polling_interval
    chown system system /sys/module/msm_core/parameters/disabled
    chown system system /sys/kernel/debug/msm_core/enable
    chown system system /sys/kernel/debug/msm_core/ptable

    chown system system /sys/module/radio_iris_transport/parameters/fmsmd_set
    chmod 0660 /sys/module/radio_iris_transport/parameters/fmsmd_set

    mkdir /dev/socket/qmux_radio 0770 radio radio
    chmod 2770 /dev/socket/qmux_radio
    mkdir /dev/socket/qmux_audio 0770 media audio
    chmod 2770 /dev/socket/qmux_audio
    mkdir /dev/socket/qmux_bluetooth 0770 bluetooth bluetooth
    chmod 2770 /dev/socket/qmux_bluetooth
    mkdir /dev/socket/qmux_gps 0770 gps gps
    chmod 2770 /dev/socket/qmux_gps

    mkdir /mnt/per/drm 0770 system system
    mkdir /mnt/per/bluetooth 0770 bluetooth bluetooth
    mkdir /mnt/per/misc 0770 system system
    mkdir /mnt/per/alarm 0770 system system
    mkdir /mnt/per/time 0770 system system
    mkdir /mnt/per/secnvm 0770 system system

    mkdir /dev/socket/netmgr 0750 radio radio

    chown wifi wifi /sys/module/wlan/parameters/fwpath
    chmod 0660 /sys/module/wlan/parameters/fwpath
    setprop wifi.interface wlan0
    setprop net.tcp.buffersize.wifi    524288,2097152,4194304,262144,524288,1048576
    setprop ro.telephony.call_ring.multiple false
    setprop persist.camera.gyro.disable 0

    chmod 0444 /sys/devices/platform/msm_hsusb/gadget/usb_state
    chmod 0666 /sys/class/kgsl/kgsl-3d0/devfreq/min_freq

    setprop net.tcp.buffersize.default 4096,87380,524288,4096,16384,110208
    setprop net.tcp.buffersize.lte     2097152,4194304,8388608,262144,524288,1048576
    setprop net.tcp.buffersize.umts    4094,87380,110208,4096,16384,110208
    setprop net.tcp.buffersize.hspa    4094,87380,1220608,4096,16384,1220608
    setprop net.tcp.buffersize.hsupa   4094,87380,1220608,4096,16384,1220608
    setprop net.tcp.buffersize.hsdpa   4094,87380,1220608,4096,16384,1220608
    setprop net.tcp.buffersize.hspap   4094,87380,1220608,4096,16384,1220608
    setprop net.tcp.buffersize.edge    4093,26280,35040,4096,16384,35040
    setprop net.tcp.buffersize.gprs    4092,8760,11680,4096,8760,11680
    setprop net.tcp.buffersize.evdo    4094,87380,524288,4096,16384,262144
    setprop net.tcp.2g_init_rwnd 10
    write /proc/sys/net/core/rmem_max  8388608
    write /proc/sys/net/core/wmem_max  8388608
    write /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal 1
    write /proc/sys/kernel/printk "6 6 1 7"

    chown system system /sys/module/ccid_bridge/parameters/bulk_msg_timeout

    chown wifi wifi /sys/class/net/bond0/bonding/queue_id

    chown root system /dev/block/by-name/rawdump
    chmod 0660 /dev/block/by-name/rawdump
    chown root system /sys/kernel/dload/emmc_dload
    chmod 0660 /sys/kernel/dload/emmc_dload
    chown root system /dev/block/by-name/ramdump
    chmod 0660 /dev/block/by-name/ramdump
    chown root system /sys/kernel/dload/dload_mode
    chmod 0660 /sys/kernel/dload/dload_mode

    chown system system /sys/class/backlight/panel0-backlight/brightness
    chown system system /sys/class/backlight/panel0-backlight/max_brightness

    chown system system /sys/class/sensors/MPU6050-accel/enable
    chown system system /sys/class/sensors/MPU6050-accel/poll_delay
    chown system system /sys/class/sensors/MPU6050-gyro/enable
    chown system system /sys/class/sensors/MPU6050-gyro/poll_delay
    chown system system /sys/class/sensors/compass/enable
    chown system system /sys/class/sensors/compass/poll_delay
    chown system system /sys/class/sensors/st480/enable
    chown system system /sys/class/sensors/st480/poll_delay
    chown system system /sys/class/sensors/bma2x2-accel/enable
    chown system system /sys/class/sensors/bma2x2-accel/poll_delay
    chown system system /sys/class/sensors/kionix-accel/enable
    chown system system /sys/class/sensors/kionix-accel/poll_delay
    chown system system /sys/class/sensors/mc3xxx-accel/enable
    chown system system /sys/class/sensors/mc3xxx-accel/poll_delay
    chmod 0666 /sys/class/sensors/mc3xxx-accel/enable
    chmod 0666 /sys/class/sensors/mc3xxx-accel/name
    chown system system /sys/class/sensors/ltr553-light/enable
    chown system system /sys/class/sensors/ltr553-light/poll_delay
    chown system system /sys/class/sensors/ltr553-proximity/enable
    chown system system /sys/class/sensors/ltr553-proximity/poll_delay
    chown system system /sys/class/sensors/ap3426-light/enable
    chown system system /sys/class/sensors/ap3426-light/poll_delay
    chown system system /sys/class/sensors/ap3426-proximity/enable
    chown system system /sys/class/sensors/ap3426-proximity/poll_delay
    chown system system /sys/class/sensors/apds9930-light/enable
    chown system system /sys/class/sensors/apds9930-light/poll_delay
    chown system system /sys/class/sensors/apds9930-proximity/enable
    chown system system /sys/class/sensors/apds9930-proximity/poll_delay
    chown system system /sys/class/sensors/cm36686-light/enable
    chown system system /sys/class/sensors/cm36686-light/poll_delay
    chown system system /sys/class/sensors/cm36686-proximity/enable
    chown system system /sys/class/sensors/cm36686-proximity/poll_delay
    chown system system /sys/class/sensors/epl88051-light/enable
    chown system system /sys/class/sensors/epl88051-light/poll_delay
    chown system system /sys/class/sensors/epl88051-proximity/enable
    chown system system /sys/class/sensors/epl88051-proximity/poll_delay

    chown root system /sys/class/bst/ACC/calibration
    chmod 0666 /sys/class/bst/ACC/calibration
    chown root system /sys/devices/virtual/gesture_mode/tp_gesture_status/gesture

    mkdir /mnt/per/display 0770 system graphics

    chmod 0664 /proc/smb358_otg_enable
    chown root system /proc/smb358_otg_enable

    write /sys/bus/msm_subsys/devices/subsys0/restart_level related
    write /sys/bus/msm_subsys/devices/subsys1/restart_level related
    write /sys/bus/msm_subsys/devices/subsys2/restart_level related

    start vendor.rmt_storage

on post-fs-data
    mkdir /data/vendor/misc 01771 system system

    mkdir /data/vendor/display 0770 system graphics
    mkdir /data/vendor/lm 0700 root root
    mkdir /data/vendor/media 0770 mediacodec media

    mkdir /data/vendor/misc/qti_fp 0770 system system
    mkdir /data/vendor/misc/qti_fp/bg_estimation 0770 system system
    mkdir /data/vendor/misc/qti_fp/calib_test 0770 system system
    mkdir /data/vendor/misc/qti_fp/database 0770 system system

    mkdir /data/vendor/qdmastats 0700 system system
    mkdir /data/vendor/qdma 0770 system system

    mkdir /data/misc/qsee 0770 system system
    mkdir /data/vendor/qtee 0770 system system
    mkdir /data/misc/qvop 0771 system system

    mkdir /data/misc/camera 0770 camera camera
    mkdir /data/vendor/camera 0770 camera camera

    mkdir /data/media 0770 media_rw media_rw
    chown media_rw media_rw /data/media

    mkdir /data/vendor/tombstones 0771 system system
    mkdir /data/tombstones 0771 system system
    mkdir /tombstones/modem 0771 system system
    mkdir /tombstones/lpass 0771 system system
    mkdir /tombstones/wcnss 0771 system system
    mkdir /tombstones/dsps 0771 system system

    mkdir /data/vendor/ramdump 0771 root system
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    mkdir /data/vendor/ramdump/bluetooth 0770 bluetooth bluetooth

    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/ctrl 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/wpa_supplicant 0770 wifi wifi
    copy /vendor/etc/wifi/wpa_supplicant.conf /data/misc/wifi/wpa_supplicant.conf
    chown wifi wifi /data/misc/wifi/wpa_supplicant.conf
    chmod 0660 /data/misc/wifi/wpa_supplicant.conf
    copy /vendor/etc/wifi/wpa_supplicant.conf /data/misc/wifi/p2p_supplicant.conf
    chown wifi wifi /data/misc/wifi/p2p_supplicant.conf
    chmod 0660 /data/misc/wifi/p2p_supplicant.conf
    copy /vendor/etc/wifi/WCNSS_qcom_cfg.ini /data/misc/wifi/WCNSS_qcom_cfg.ini
    chown wifi wifi /data/misc/wifi/WCNSS_qcom_cfg.ini
    chmod 0660 /data/misc/wifi/WCNSS_qcom_cfg.ini
    mkdir /data/misc/dhcp 0777 dhcp dhcp
    chown dhcp dhcp /data/misc/dhcp

    mkdir /data/vendor/port_bridge 0770 radio radio
    chmod 0770 /data/vendor/port_bridge
    mkdir /data/vendor/netmgr 0770 radio radio
    chmod 0770 /data/vendor/netmgr
    mkdir /data/vendor/ipa 0770 radio radio
    chmod 0770 /data/vendor/ipa

    mkdir /data/connectivity 0771 system system
    chown system system /data/connectivity

    mkdir /data/vendor/misc/audio 0770 audio audio
    mkdir /data/vendor/misc/audio/acdbdata 0770 media audio
    mkdir /data/vendor/misc/audio/acdbdata/delta 0770 media audio
    mkdir /data/misc/dash 0770 media audio
    mkdir /data/misc/dts 0770 media audio
    mkdir /data/vendor/audio/ 0770 media audio
    mkdir /data/vendor/audio/acdbdata 0770 media audio
    mkdir /data/vendor/audio/acdbdata/delta 0770 media audio

    mkdir /data/vendor/radio 0770 system radio
    write /data/vendor/radio/copy_complete 0
    chown radio radio /data/vendor/radio/copy_complete
    chmod 0660 /data/vendor/radio/copy_complete
    copy /vendor/radio/qcril_database/qcril.db /data/vendor/radio/qcril_prebuilt.db
    chown radio radio /data/vendor/radio/qcril_prebuilt.db
    chmod 0660 /data/vendor/radio/qcril_prebuilt.db
    write /data/vendor/radio/prebuilt_db_support 1
    chown radio radio /data/vendor/radio/prebuilt_db_support
    chmod 0400 /data/vendor/radio/prebuilt_db_support
    write /data/vendor/radio/db_check_done 0
    chown radio radio /data/vendor/radio/db_check_done
    chmod 0660 /data/vendor/radio/db_check_done

    chown root system /mnt/per
    chmod 0771 /mnt/per
    chown system system /mnt/per/WCNSS_qcom_wlan_nv.bin
    chmod 0664 /sys/devices/platform/msm_sdcc.1/polling
    chmod 0664 /sys/devices/platform/msm_sdcc.2/polling
    chmod 0664 /sys/devices/platform/msm_sdcc.3/polling
    chmod 0664 /sys/devices/platform/msm_sdcc.4/polling
    chown system system /sys/devices/platform/msm_sdcc.1/polling
    chown system system /sys/devices/platform/msm_sdcc.2/polling
    chown system system /sys/devices/platform/msm_sdcc.3/polling
    chown system system /sys/devices/platform/msm_sdcc.4/polling
    mkdir /mnt/per/data/sfs 0700 system system
    mkdir /mnt/per/data/tz 0700 system system

    mkdir /data/system 0775 system system

    mkdir /data/vendor/location 0770 gps gps
    mkdir /data/vendor/location/mq 0770 gps gps
    mkdir /data/vendor/location/xtwifi 0770 gps gps

    mkdir /data/shared 0755
    chown system system /data/shared

    mkdir /data/fota 0771
    chown system system /data/fota

    mkdir /data/hostapd 0770 system wifi

    mkdir /data/time/ 0700 system system

    mkdir /data/vendor/perfd 0770 root system
    chmod 2770 /data/vendor/perfd
    rm /data/vendor/perfd/default_values

    mkdir /data/nfc 0770 nfc nfc
    mkdir /data/nfc/param 0770 nfc nfc

    mkdir /data/vendor/iop 0770 root system

    mkdir /data/system/swap 0770 root system
    chmod 2770 /data/system/swap

    write /sys/block/dm-0/queue/read_ahead_kb 2048
    write /sys/block/dm-1/queue/read_ahead_kb 2048

    mkdir /data/misc/fm 0770 system system
    chmod 0770 /data/misc/fm

    setprop vold.post_fs_data_done 1

on charger
    setprop persist.sys.usb.config mass_storage

    load_system_props
    chown root system /sys/class/power_supply/bms/current_now
    chown root system /sys/class/power_supply/bms/voltage_ocv
    chmod 0664 /sys/class/power_supply/bms/current_now
    chmod 0664 /sys/class/power_supply/bms/voltage_ocv
    chown root system /sys/power/wake_lock
    chown root system /sys/power/wake_unlock
    chmod 0660 /sys/power/wake_lock
    chmod 0660 /sys/power/wake_unlock
    start vendor.qcom-post-boot

on charger && property:ro.vendor.vm_bms.enabled=1
    start vendor.vm_bms

on property:sys.boot_completed=1
    write /dev/kmsg "Boot completed "
    write /sys/block/dm-0/queue/read_ahead_kb 128
    write /sys/block/dm-1/queue/read_ahead_kb 128
    chown media audio /sys/kernel/wdsp0/boot
    chown media audio /sys/kernel/wcd_cpe0/fw_name
    start vendor.qcom-post-boot

on property:persist.debug.trace=1
    mkdir /data/core 0777 root root
    write /proc/sys/kernel/core_pattern "/data/core/%E.%p.%e"

on property:vold.decrypt=trigger_restart_framework
    start vendor.wcnss-service

on property:persist.env.fastdorm.enabled=true
    setprop persist.radio.data_no_toggle 1

on property:persist.sys.ssr.enable_debug=*
    write /sys/module/subsystem_restart/parameters/enable_debug ${persist.sys.ssr.enable_debug}

on property:persist.sys.mba_boot_timeout=*
    write /sys/module/pil_msa/parameters/pbl_mba_boot_timeout_ms ${persist.sys.mba_boot_timeout}

on property:persist.sys.modem_auth_timeout=*
    write /sys/module/pil_msa/parameters/modem_auth_timeout_ms ${persist.sys.modem_auth_timeout}

on property:persist.sys.pil_proxy_timeout=*
    write /sys/module/peripheral_loader/parameters/proxy_timeout_ms ${persist.sys.pil_proxy_timeout}

on property:persist.sys.ssr.enable_ramdumps=1
    write /sys/module/subsystem_restart/parameters/enable_ramdumps 1
    mkdir /data/ramdump 770 system system

on property:persist.sys.ssr.enable_ramdumps=0
    write /sys/module/subsystem_restart/parameters/enable_ramdumps 0

on property:ro.use_data_netmgrd=false
    stop vendor.netmgrd

on property:ro.data.large_tcp_window_size=true
    write /proc/sys/net/ipv4/tcp_adv_win_scale  2

on property:sys.sysctl.tcp_adv_win_scale=*
    write /proc/sys/net/ipv4/tcp_adv_win_scale ${sys.sysctl.tcp_adv_win_scale}

on property:wifi.ftmd.load=true
    write /sys/module/wlan/parameters/con_mode 5

on property:vendor.rild.libpath=*
    setprop rild.libpath ${vendor.rild.libpath}

on property:persist.radio.atfwd.start=true
    start vendor.atfwd

on property:sys.qbcharger.enable=true
    start qbcharger

on property:sys.qbcharger.enable=false
    stop qbcharger

on property:sys.runin.charger.control=1
    write /sys/class/power_supply/battery/charging_enabled 0

on property:sys.runin.charger.control=0
    write /sys/class/power_supply/battery/charging_enabled 1

on property:init.svc.surfaceflinger=stopped
    stop vendor.ppd

on property:init.svc.surfaceflinger=running
    start vendor.ppd

on property:init.svc.surfaceflinger=restarting
    stop hwcomposer-2-1
    start hwcomposer-2-1

on property:sys.shutdown.requested=*
    stop cnss-daemon

on property:persist.otg_function.enable=1
    write /proc/smb358_otg_enable 1

on property:persist.otg_function.enable=0
    write /proc/smb358_otg_enable 0

on property:hw.fm.init=1
    write /sys/module/radio_iris_transport/parameters/fmsmd_set 1

on property:hw.fm.init=0
    write /sys/module/radio_iris_transport/parameters/fmsmd_set 0

service vendor.irsc_util /vendor/bin/irsc_util "/vendor/etc/sec_config"
    class core
    user root
    oneshot

service vendor.rmt_storage /vendor/bin/rmt_storage
    class core
    user root
    shutdown critical
    ioprio rt 0

service vendor.tftp_server /vendor/bin/tftp_server
    class core
    user root

service vendor.port-bridge /vendor/bin/port-bridge
    class main
    user radio
    group radio system inet
    disabled
    oneshot

service vendor.qmuxd /vendor/bin/qmuxd
    class main
    user root
    group radio audio bluetooth gps nfc diag
    disabled

service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system net_raw
    disabled

service vendor.netmgrd /vendor/bin/netmgrd
    class main
    disabled

service vendor.qti /vendor/bin/qti
    class main
    user radio
    group radio oem_2901 diag usb net_admin
    disabled

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service cnss-daemon /vendor/bin/cnss-daemon -n -l
    class late_start
    user system
    group system inet net_admin wifi
    capabilities NET_ADMIN

service loc_launcher /vendor/bin/loc_launcher
    class late_start
    group gps inet diag wifi

service vendor.qcom-post-boot /vendor/bin/init.qcom.post_boot.sh
    class late_start
    user root
    disabled
    oneshot

service vendor.atfwd /vendor/bin/ATFWD-daemon
    class late_start
    user system
    group system radio
    disabled

service hostapd_fst /vendor/bin/hostapd -dd -g /data/vendor/wifi/hostapd/global /data/misc/wifi/hostapd.conf
    class late_start
    user wifi
    group wifi inet keystore net_admin net_raw
    oneshot
    disabled

service charger /charger
    class charger
    group system graphics
    seclabel u:r:healthd:s0

service qbcharger /charger -m 1
    disabled
    oneshot

service vendor.vm_bms /vendor/bin/vm_bms
    user root
    group root
    disabled

service vendor.time_daemon /vendor/bin/time_daemon
    class main
    user root
    group root

service vendor.qcamerasvr /vendor/bin/mm-qcamera-daemon
    class late_start
    user camera
    group camera system inet input graphics

service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root

service vendor.qsee-kmload /vendor/bin/sh -c "until getprop sys.listeners.registered | grep -q true; do sleep 1; done; setprop sys.keymaster.loaded true"
    class core
    user root
    group root
    oneshot
    disabled

service vendor.thermal-engine /vendor/bin/thermal-engine
    class main
    user root
    socket thermal-send-client stream 0666 system system
    socket thermal-recv-client stream 0660 system system
    socket thermal-recv-passive-client stream 0666 system system
    socket thermal-send-rule stream 0660 system system
    group root

service vendor.wcnss-service /vendor/bin/wcnss_service
    class main
    user system
    group system wifi radio
    oneshot

service vendor.ppd /vendor/bin/mm-pp-dpps
    class late_start
    disabled
    user system
    socket pps stream 0660 system system
    group system graphics
