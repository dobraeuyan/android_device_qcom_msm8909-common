vndbinder_use(hal_gnss_default)

allow hal_gnss_default self:socket create_socket_perms_no_ioctl;

allow hal_gnss_default location_data_file:dir create_dir_perms;
allow hal_gnss_default location_data_file:sock_file { create write setattr unlink };

allow hal_gnss_default self:socket ioctl;
allowxperm hal_gnss_default self:socket ioctl msm_sock_ipc_ioctls;
allow hal_gnss_default sysfs:file r_file_perms;

allow hal_gnss_default ssr_device:chr_file r_file_perms;
allow hal_gnss_default self:netlink_generic_socket create_socket_perms_no_ioctl;
allow hal_gnss_default location:unix_stream_socket connectto;
