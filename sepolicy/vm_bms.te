type vm_bms, domain;
type vm_bms_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vm_bms)

allow vm_bms {
    tmpfs
    vm_bms_device
    battery_data_device
}:chr_file rw_file_perms;

allow vm_bms {
    sysfs_battery_supply
    sysfs_usb_supply
}:dir r_dir_perms;

allow vm_bms {
    sysfs_battery_supply
    sysfs_usb_supply
}:file rw_file_perms;

allow vm_bms self:capability { setpcap setgid setuid };

wakelock_use(vm_bms)
