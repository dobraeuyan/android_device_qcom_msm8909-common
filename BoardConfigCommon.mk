PLATFORM_PATH := device/qcom/msm8909-common

PRODUCT_SOONG_NAMESPACES += hardware/qcom/display/msm8909

TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi
TARGET_CPU_VARIANT := cortex-a7

TARGET_USES_64_BIT_BINDER := true

BOARD_USES_ALSA_AUDIO := true
USE_XML_AUDIO_POLICY_CONF := 1

BOARD_HAVE_BLUETOOTH_QCOM := true
QCOM_BT_USE_BTNV := true
USE_DEVICE_SPECIFIC_BT_VENDOR := true
DEVICE_SPECIFIC_BT_VENDOR_PATH := $(PLATFORM_PATH)/bt-vendor

TARGET_BOOTLOADER_BOARD_NAME := msm8909
TARGET_NO_BOOTLOADER := true

BOARD_USES_ADRENO := true

NUM_FRAMEBUFFER_SURFACE_BUFFERS := 3

TARGET_USES_HWC2 := true
TARGET_USES_GRALLOC1 := true
TARGET_USES_ION := true

USE_DEVICE_SPECIFIC_DISPLAY := true
DEVICE_SPECIFIC_DISPLAY_PATH := hardware/qcom/display/msm8909

OVERRIDE_RS_DRIVER := libRSDriver_adreno.so

BOARD_HAVE_QCOM_FM := true
TARGET_QCOM_NO_FM_FIRMWARE := true

PRODUCT_GMS_CLIENTID_BASE := android-lenovo

DEVICE_MANIFEST_FILE := $(PLATFORM_PATH)/manifest.xml
DEVICE_MATRIX_FILE := $(PLATFORM_PATH)/compatibility_matrix.xml

BOARD_KERNEL_BASE := 0x80000000
BOARD_KERNEL_IMAGE_NAME := zImage-dtb
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_SEPARATED_DT := true
BOARD_MKBOOTIMG_ARGS := --ramdisk_offset 0x02000000 --tags_offset 0x01e00000 --board boot:0

TARGET_KERNEL_ARCH := arm
TARGET_KERNEL_SOURCE := kernel/qcom/msm8909-common
TARGET_KERNEL_CONFIG := lineage_msm8909_defconfig

BOARD_KERNEL_CMDLINE := console=ttyHSL0,115200,n8 earlycon=msm_serial_dm,0x78af000
BOARD_KERNEL_CMDLINE += androidboot.console=ttyHSL0 androidboot.hardware=qcom panic=30
BOARD_KERNEL_CMDLINE += ehci-hcd.park=3 androidboot.bootdevice=7824900.sdhci
BOARD_KERNEL_CMDLINE += androidboot.memcg=true androidboot.usbcontroller=msm_hsusb
BOARD_KERNEL_CMDLINE += firmware_class.path=/mnt/fwmt/image msm_poweroff.download_mode=0

TARGET_KEYMASTER_WAIT_FOR_QSEE := true

BOARD_FLASH_BLOCK_SIZE := 131072

BOARD_BOOTIMAGE_PARTITION_SIZE := 33554432
BOARD_PERSISTIMAGE_PARTITION_SIZE := 33554432
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 33554432

BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_USERIMAGES_USE_F2FS := true
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USES_MKE2FS := true

TARGET_BOARD_PLATFORM := msm8909

TARGET_VENDOR_PROP += $(PLATFORM_PATH)/vendor.prop

BOARD_USES_QCOM_HARDWARE := true

include device/qcom/sepolicy/sepolicy.mk

BOARD_SEPOLICY_DIRS += $(PLATFORM_PATH)/sepolicy

TARGET_LD_SHIM_LIBS += /vendor/bin/hw/android.hardware.drm@1.0-service.widevine|libwvdrm_shim.so
TARGET_LD_SHIM_LIBS += /vendor/bin/slim_daemon|libslim_shim.so
TARGET_LD_SHIM_LIBS += /vendor/bin/xtra-daemon|libizatapi_shim.so

BOARD_VNDK_VERSION := current
BOARD_VNDK_RUNTIME_DISABLE := true
TARGET_COPY_OUT_VENDOR := vendor

VENDOR_SECURITY_PATCH := 2020-08-01

BOARD_HAS_QCOM_WLAN := true
BOARD_WLAN_DEVICE := qcwcn
BOARD_HOSTAPD_DRIVER := NL80211
BOARD_HOSTAPD_PRIVATE_LIB := lib_driver_cmd_$(BOARD_WLAN_DEVICE)
BOARD_WPA_SUPPLICANT_DRIVER := NL80211
BOARD_WPA_SUPPLICANT_PRIVATE_LIB := lib_driver_cmd_$(BOARD_WLAN_DEVICE)
WIFI_DRIVER_FW_PATH_STA := "sta"
WIFI_DRIVER_FW_PATH_AP := "ap"
WIFI_DRIVER_STATE_CTRL_PARAM := "/sys/module/wlan/parameters/fwpath"
WIFI_DRIVER_STATE_ON := "sta"
WIFI_DRIVER_STATE_OFF := "off"
WPA_SUPPLICANT_VERSION := VER_0_8_X
